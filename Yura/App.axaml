<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yura.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Yura/Themes/Light.axaml" />
        <StyleInclude Source="avares://Yura/Themes/Dark.axaml" />
    </Application.Styles>
</Application>
