<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="PrimaryBackground">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryBackground">#F0F0F0</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryHover">#E0E0E0</SolidColorBrush>
        <SolidColorBrush x:Key="ForegroundColor">#1E1E1E</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
    </Style>
    <Style Selector="TreeView">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
    </Style>
</Styles>
